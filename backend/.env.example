# backend/.env.example
# Copiar como .env y completar con los valores locales.
# El .env real esta en .gitignore: nunca se commitea.

# --- Flask ---
# OBLIGATORIO. Sin este valor la aplicacion NO arranca (falla con un
# mensaje que explica que falta). No tiene ningun valor por defecto: uno
# commiteado seria un secreto publico firmando los JWT de todos.
# Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

FLASK_DEBUG=1

# --- JWT ---
# OBLIGATORIO, igual que SECRET_KEY. Generar uno DISTINTO con el mismo
# comando: son dos secretos separados a proposito.
JWT_SECRET_KEY=

# Segundos de validez del token de acceso. 3600 = 1 hora.
JWT_ACCESS_TOKEN_EXPIRES=3600

# --- Recuperacion de contrasena ---
# 1 = la API devuelve el enlace en la respuesta (desarrollo, sin mail).
# Si se omite, sigue a FLASK_DEBUG. En produccion tiene que quedar en 0.
RECUPERACION_MOSTRAR_TOKEN=1

# --- Base de datos (una instancia MySQL local por integrante) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=asisto
DB_USER=
DB_PASSWORD=

# --- CORS (origenes separados por coma) ---
CORS_ORIGINS=http://localhost:5173
