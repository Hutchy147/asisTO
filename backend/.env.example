# backend/.env.example
# Copiar como .env y completar con los valores locales.
# El .env real esta en .gitignore: nunca se commitea.

# --- Flask ---
SECRET_KEY=
FLASK_DEBUG=1

# --- JWT ---
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600

# --- Base de datos (una instancia MySQL local por integrante) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=asisto
DB_USER=
DB_PASSWORD=

# --- CORS (origenes separados por coma) ---
CORS_ORIGINS=http://localhost:5173
