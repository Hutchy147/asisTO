# backend/.env.example
# Copiar como .env y completar con los valores locales.
# El .env real esta en .gitignore: nunca se commitea.

# --- Flask ---
# OBLIGATORIO. Sin este valor la aplicacion NO arranca (falla con un
# mensaje que explica que falta). No tiene ningun valor por defecto: uno
# commiteado seria un secreto publico firmando los JWT de todos.
# Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

FLASK_DEBUG=1

# --- JWT ---
# OBLIGATORIO, igual que SECRET_KEY. Generar uno DISTINTO con el mismo
# comando: son dos secretos separados a proposito.
JWT_SECRET_KEY=

# Segundos de validez del token de acceso. 3600 = 1 hora.
JWT_ACCESS_TOKEN_EXPIRES=3600

# --- Recuperacion de contrasena ---
# 1 = la API devuelve el enlace en la respuesta (desarrollo, sin mail).
# Si se omite, sigue a FLASK_DEBUG. En produccion tiene que quedar en 0: con
# FLASK_DEBUG=0 y este valor en 1 la aplicacion se niega a arrancar.
RECUPERACION_MOSTRAR_TOKEN=1

# --- Informes con IA (opcional) ---
# Sin estos valores los informes se arman con una plantilla que vuelca los
# datos del periodo (funciona igual, no sale nada del servidor). Con proveedor
# y clave, la IA redacta el borrador; el nombre del paciente no se envia y la
# terapeuta siempre revisa antes de publicar. Proveedor soportado: anthropic.
INFORMES_IA_PROVEEDOR=
INFORMES_IA_API_KEY=
INFORMES_IA_MODELO=claude-sonnet-5-5
# Alternativa local, sin clave y sin salida a internet (Ollama):
#   INFORMES_IA_PROVEEDOR=ollama
#   INFORMES_IA_MODELO=<modelo instalado, ver `ollama list`>
#   INFORMES_IA_URL=http://127.0.0.1:11434
#   INFORMES_IA_TIMEOUT=300   (un modelo local tarda mas que uno en la nube)
#   INFORMES_IA_CTX=8192      (tokens de contexto; subirlo si el periodo es largo)
#   INFORMES_IA_KEEP_ALIVE=30m (el modelo queda cargado: evita la espera de carga)

# --- Base de datos (una instancia MySQL local por integrante) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=asisto
DB_USER=
DB_PASSWORD=

# --- Seguridad (ver docs/seguridad.md) ---
# Cookie de sesion solo por HTTPS. Si se omite: 0 con FLASK_DEBUG=1, 1 si no.
# COOKIE_SEGURA=1
# Detras de un proxy inverso (nginx, IIS): cantidad de saltos confiables para
# leer la IP real del cliente. 0 = no hay proxy (no se confia en la cabecera).
PROXIES_CONFIABLES=0
# Limites por IP cada 15 minutos (0 apaga el limite).
# LIMITE_LOGIN_FALLIDOS_POR_IP=30
# LIMITE_RECUPERAR_POR_IP=10
# LIMITE_RESTABLECER_POR_IP=20

# --- CORS (origenes separados por coma) ---
CORS_ORIGINS=http://localhost:5173
